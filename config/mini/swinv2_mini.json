{
    "seed_everything": 42,
    "model": {
        "class_path": "SwinV2Model",
        "init_args": {
            "num_classes": 352,
            "learning_rate": 1e-4,
            "input_size": 448,
            "t_max": 17,
            "mix_prob_early": 0.8,
            "mix_prob_late": 0.2
        }
    },
    "trainer": {
        "max_epochs": 17,
        "accelerator": "gpu",
        "devices": 1,
        "precision": "bf16-mixed",
        "accumulate_grad_batches": 8,
        "callbacks": [
            {
                "class_path": "pytorch_lightning.callbacks.EarlyStopping",
                "init_args": {
                    "monitor": "val/acc_top1",
                    "patience": 7,
                    "mode": "max"
                }
            },
            {
                "class_path": "pytorch_lightning.callbacks.ModelCheckpoint",
                "init_args": {
                    "monitor": "val/acc_top1",
                    "filename": "swinv2-all-{epoch:02d}-{val/acc_top1:.4f}",
                    "save_top_k": 5,
                    "save_last": true,
                    "mode": "max"
                }
            },
            {
                "class_path": "pytorch_lightning.callbacks.LearningRateMonitor",
                "init_args": {
                    "logging_interval": "step"
                }
            },
            {
                "class_path": "callbacks.epoch_stopping.EpochStoppingCallback",
                "init_args": {
                    "stop_at_epoch": 10
                }
            }
        ]
    },
    "data": {
        "class_path": "SpecialCateData",
        "init_args": {
            "data_dir": "./data/train-mini",
            "valid_dir": "./data/valid-mini",
            "id_map_file_path": "mini_map.csv",
            "valid_id_map_file_path": "valid_mini_map.csv",
            "batch_size": 15,
            "num_workers": 5,
            "input_size": 448,
            "rrc_scale_min": 0.3,
            "random_erase_prob": 0.25
        }
    }
}