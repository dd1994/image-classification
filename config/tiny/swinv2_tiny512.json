{
    "seed_everything": 1,
    "model": {
        "class_path": "SwinV2Model",
        "init_args": {
            "num_classes": 168,
            "learning_rate": 1e-4,
            "input_size": 512,
            "t_max": 17,
            "mix_prob_early": 0.8,
            "mix_prob_late": 0,
            "mix_alpha": 0.8,
            "use_arcface": true,
            "arcface_s": 30.0,
            "arcface_m": 0.3,
            "arcface_sub_center": 3,
            "arcface_easy_margin": false,
            "arcface_ls_eps": 0.0,
            "arcface_margin_warmup_epochs": 3,
            "arcface_margin_warmup_start": 0.1,
            "use_gradient_checkpointing": false
        }
    },
    "trainer": {
        "max_epochs": 17,
        "accelerator": "gpu",
        "devices": 1,
        "precision": "bf16-mixed",
        "accumulate_grad_batches": 13,
        "callbacks": [
            {
                "class_path": "pytorch_lightning.callbacks.EarlyStopping",
                "init_args": {
                    "monitor": "val/acc_top1",
                    "patience": 7,
                    "mode": "max"
                }
            },
            {
                "class_path": "pytorch_lightning.callbacks.ModelCheckpoint",
                "init_args": {
                    "monitor": "val/acc_top1",
                    "filename": "swinv2-all-{epoch:02d}-{val/acc_top1:.4f}",
                    "save_top_k": 5,
                    "save_last": true,
                    "mode": "max"
                }
            },
            {
                "class_path": "pytorch_lightning.callbacks.LearningRateMonitor",
                "init_args": {
                    "logging_interval": "step"
                }
            }
        ]
    },
    "data": {
        "class_path": "SpecialCateData",
        "init_args": {
            "data_dir": "./data/train-tiny",
            "valid_dir": "./data/valid-tiny",
            "id_map_file_path": "tiny_map.csv",
            "valid_id_map_file_path": "valid_tiny_map.csv",
            "batch_size": 9,
            "num_workers": 5,
            "input_size": 512,
            "rrc_scale_min": 0.5,
            "random_erase_prob": 0.25,
            "re_scale_min": 0.02,
            "re_scale_max": 0.2,
            "rebalance_last_epochs": 0,
            "rebalance_floor_count": 150,
            "trivial_augment_prob": 1
        }
    }
}