{
  "model": {
      "class_path": "SwinV2FixResModel",
      "init_args": {
          "num_classes": 163,
          "learning_rate": 3e-5,
          "input_size": 448,
          "t_max": 4,
          "ckpt": "wandb_logs/identify/aolaubgz/checkpoints/last.ckpt"
      }
  },
  "trainer": {
      "max_epochs": 4,
      "accelerator": "gpu",
      "devices": 1,
      "precision": "16-mixed",
      "callbacks": [
        {
            "class_path": "pytorch_lightning.callbacks.EarlyStopping",
            "init_args": {
                "monitor": "val/acc_top1",
                "patience": 7,
                "mode": "max"
            }
        },
        {
            "class_path": "pytorch_lightning.callbacks.ModelCheckpoint",
            "init_args": {
                "monitor": "val/acc_top1",
                "filename": "swinv2-inat2019-small-fix-res-{epoch:02d}-{val/acc_top1:.4f}",
                "save_top_k": 3,
                "save_last": true,
                "mode": "max"
            }
        },
        {
            "class_path": "pytorch_lightning.callbacks.LearningRateMonitor",
            "init_args": {
                "logging_interval": "step"
            }
        }
    ]
  },
  "data":  {
    "class_path": "INatDataModule2019",
    "init_args": {
      "data_dir": "./data/small",
      "batch_size": 16,
      "num_workers": 3,
      "input_size": 448
    }
  }
}