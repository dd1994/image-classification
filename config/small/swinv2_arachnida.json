{
  "model": {
      "class_path": "SwinV2Model",
      "init_args": {
          "num_classes": 843,
          "learning_rate": 1.5e-4,
          "input_size": 448,
          "t_max": 17
      }
  },
  "trainer": {
      "max_epochs": 17,
      "accelerator": "gpu",
      "devices": 1,
      "precision": "16-mixed",
      "accumulate_grad_batches": 8,
      "callbacks": [
        {
            "class_path": "pytorch_lightning.callbacks.EarlyStopping",
            "init_args": {
                "monitor": "val/acc_top1",
                "patience": 7,
                "mode": "max"
            }
        },
        {
            "class_path": "pytorch_lightning.callbacks.ModelCheckpoint",
            "init_args": {
                "monitor": "val/acc_top1",
                "filename": "swinv2-arachnida-small-{epoch:02d}-{val/acc_top1:.4f}",
                "save_top_k": 3,
                "save_last": true,
                "mode": "max"
            }
        },
        {
            "class_path": "pytorch_lightning.callbacks.LearningRateMonitor",
            "init_args": {
                "logging_interval": "step"
            }
        }
    ]
  },
  "data":  {
    "class_path": "SpecialCateData",
    "init_args": {
      "data_dir": "./data/train-mini/Arachnida",
      "valid_dir": "./data/valid-mini/Arachnida",
      "id_map_file_path": "arachnida_id_map.csv",
      "valid_id_map_file_path": "valid_arachnida_id_map.csv",
      "batch_size": 16,
      "num_workers": 12,
      "input_size": 448
    }
  }
}