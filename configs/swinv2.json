{
  "model": {
      "class_path": "SwinV2Model",
      "init_args": {
          "num_classes": 51,
          "learning_rate": 1e-4,
          "input_size": 448
      }
  },
  "trainer": {
      "max_epochs": 20,
      "accelerator": "gpu",
      "devices": 1,
      "precision": "16-mixed",
      "callbacks": [
        {
            "class_path": "pytorch_lightning.callbacks.EarlyStopping",
            "init_args": {
                "monitor": "val/acc_top1",
                "patience": 5,
                "mode": "max"
            }
        },
        {
            "class_path": "pytorch_lightning.callbacks.ModelCheckpoint",
            "init_args": {
                "monitor": "val/acc_top1",
                "filename": "swinv2-{epoch:02d}-{val/acc_top1:.2f}",
                "save_top_k": 1,
                "mode": "max"
            }
        },
        {
            "class_path": "pytorch_lightning.callbacks.LearningRateMonitor",
            "init_args": {
                "logging_interval": "step"
            }
        }
    ]
  },
  "data": {
      "batch_size": 32,
      "num_workers": 3
  }
}