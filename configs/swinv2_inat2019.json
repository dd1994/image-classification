{
  "model": {
      "class_path": "SwinV2Model",
      "init_args": {
          "num_classes": 1010,
          "learning_rate": 1e-4,
          "input_size": 448
      }
  },
  "trainer": {
      "max_epochs": 20,
      "accelerator": "gpu",
      "devices": 1,
      "precision": "16-mixed",
      "callbacks": [
        {
            "class_path": "pytorch_lightning.callbacks.EarlyStopping",
            "init_args": {
                "monitor": "val/acc_top1",
                "patience": 5,
                "mode": "max"
            }
        },
        {
            "class_path": "pytorch_lightning.callbacks.ModelCheckpoint",
            "init_args": {
                "monitor": "val/acc_top1",
                "filename": "swinv2-inat2019-{epoch:02d}-{val/acc_top1:.4f}",
                "save_top_k": 1,
                "mode": "max"
            }
        },
        {
            "class_path": "pytorch_lightning.callbacks.LearningRateMonitor",
            "init_args": {
                "logging_interval": "step"
            }
        }
    ]
  },
  "data":  {
    "class_path": "INatDataModule2019",
    "init_args": {
      "data_dir": "./data",
      "batch_size": 32,
      "num_workers": 16,
      "input_size": 448,
      "val_split": 0.2
    }
  }
}