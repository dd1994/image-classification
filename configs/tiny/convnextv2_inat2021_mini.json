{
  "model": {
      "class_path": "ConvNextV2Model",
      "init_args": {
          "num_classes": 51,
          "learning_rate": 1e-4,
          "input_size": 448,
          "t_max": 15
      }
  },
  "trainer": {
      "max_epochs": 15,
      "accelerator": "gpu",
      "devices": 1,
      "precision": "16-mixed",
      "callbacks": [
        {
            "class_path": "pytorch_lightning.callbacks.EarlyStopping",
            "init_args": {
                "monitor": "val/acc_top1",
                "patience": 5,
                "mode": "max"
            }
        },
        {
            "class_path": "pytorch_lightning.callbacks.ModelCheckpoint",
            "init_args": {
                "monitor": "val/acc_top1",
                "filename": "ConvNextV2-inat2021-mini-tiny-{epoch:02d}-{val/acc_top1:.4f}",
                "save_top_k": 3,
                "save_last": true,
                "mode": "max"
            }
        },
        {
            "class_path": "pytorch_lightning.callbacks.LearningRateMonitor",
            "init_args": {
                "logging_interval": "step"
            }
        }
    ]
  },
  "data":  {
    "class_path": "INatDataModule2021Mini",
    "init_args": {
      "data_dir": "./data/tiny",
      "batch_size": 20,
      "num_workers": 3,
      "input_size": 448
    }
  }
}